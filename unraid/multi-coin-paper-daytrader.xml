<?xml version="1.0" encoding="UTF-8"?>
<Container version="2">
  <Name>paper-trading-bot</Name>
  <Repository>ghcr.io/2crazytv/multi-coin-paper-daytrader:latest</Repository>
  <Registry>https://ghcr.io/2crazytv/multi-coin-paper-daytrader</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/2CrAzYTV/multi-coin-paper-daytrader/issues</Support>
  <Project>https://github.com/2CrAzYTV/multi-coin-paper-daytrader</Project>
  <Overview>Paper-only multi-coin day-trading simulator with shared risk controls, deterministic demo data, optional read-only Bitpanda Fusion market data, and a German/English dashboard. The important bot settings are exposed directly in this Unraid template, so a separate .env file is not required. Keep PAPER_ONLY=true. For live market data select DATA_SOURCE=fusion and add a Bitpanda Fusion API key with Read permission only; leave Trade and Transfer disabled. Persistent data is stored below /mnt/user/appdata/paper-trading-bot/data. The dashboard has no login and should only be used inside a trusted LAN.</Overview>
  <Category>Tools: Other:</Category>
  <WebUI>http://[IP]:[PORT:8787]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/2CrAzYTV/multi-coin-paper-daytrader/main/unraid/multi-coin-paper-daytrader.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/2CrAzYTV/multi-coin-paper-daytrader/main/unraid/multi-coin-paper-daytrader.png</Icon>
  <ExtraParams>--user=99:100 --read-only --init --tmpfs=/tmp:size=64m,mode=1777 --security-opt=no-new-privileges:true --cap-drop=ALL --pids-limit=2048 --restart=unless-stopped --stop-timeout=20</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>Create /mnt/user/appdata/paper-trading-bot/data, assign it to nobody:users (99:100), and set mode 775. Keep PAPER_ONLY=true. Default settings use €1000 paper capital, 0.5% risk per trade, 1% aggregate risk, 2% maximum daily loss, two open positions, three trades per day, BTC/ETH/SOL/XRP/ADA EUR pairs, 15-minute candles and a 1-hour trend filter. For Bitpanda Fusion select fusion and provide a Read-only API key. See docs/UNRAID.md for installation, updates, backup and troubleshooting.</Requires>

  <Config Name="WebUI Port" Target="8787" Default="8787" Mode="tcp" Description="Local dashboard port." Type="Port" Display="always" Required="true" Mask="false">8787</Config>
  <Config Name="Persistent Data" Target="/data" Default="/mnt/user/appdata/paper-trading-bot/data" Mode="rw" Description="SQLite database and cached market data. The directory must be writable by UID/GID 99:100." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/paper-trading-bot/data</Config>

  <Config Name="UI Language" Target="APP_LANGUAGE" Default="de" Mode="" Description="Default dashboard language: de or en. The UI also has a language selector." Type="Variable" Display="always" Required="true" Mask="false">de</Config>
  <Config Name="Market Data Source" Target="DATA_SOURCE" Default="demo" Mode="" Description="demo for safe simulated data or fusion for read-only Bitpanda Fusion market data." Type="Variable" Display="always" Required="true" Mask="false">demo</Config>
  <Config Name="Bitpanda Fusion Read API Key" Target="FUSION_READ_API_KEY" Default="" Mode="" Description="Required only when DATA_SOURCE=fusion. Use a Bitpanda Fusion key with Read permission only; disable Trade and Transfer." Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Starting Paper Capital" Target="STARTING_CAPITAL" Default="1000" Mode="" Description="Starting balance for the paper account in EUR." Type="Variable" Display="always" Required="true" Mask="false">1000</Config>
  <Config Name="Risk per Trade" Target="RISK_PER_TRADE" Default="0.005" Mode="" Description="Fraction of equity risked per trade. 0.005 = 0.5%. Maximum allowed by the bot is 1%." Type="Variable" Display="always" Required="true" Mask="false">0.005</Config>
  <Config Name="Maximum Aggregate Risk" Target="MAX_AGGREGATE_RISK" Default="0.01" Mode="" Description="Maximum combined open-position risk. 0.01 = 1%." Type="Variable" Display="always" Required="true" Mask="false">0.01</Config>
  <Config Name="Maximum Daily Loss" Target="MAX_DAILY_LOSS" Default="0.02" Mode="" Description="Daily loss limit. 0.02 = 2%." Type="Variable" Display="always" Required="true" Mask="false">0.02</Config>
  <Config Name="Maximum Open Positions" Target="MAX_OPEN_POSITIONS" Default="2" Mode="" Description="Maximum simultaneous paper positions (1-3)." Type="Variable" Display="always" Required="true" Mask="false">2</Config>
  <Config Name="Maximum Trades per Day" Target="MAX_TRADES_PER_DAY" Default="3" Mode="" Description="Maximum number of new paper trades per day (1-6)." Type="Variable" Display="always" Required="true" Mask="false">3</Config>
  <Config Name="Trading Pairs" Target="PAIRS" Default="BTC-EUR,ETH-EUR,SOL-EUR,XRP-EUR,ADA-EUR" Mode="" Description="Comma-separated EUR pairs, up to 10." Type="Variable" Display="always" Required="true" Mask="false">BTC-EUR,ETH-EUR,SOL-EUR,XRP-EUR,ADA-EUR</Config>
  <Config Name="Candle Interval" Target="CANDLE_INTERVAL" Default="15m" Mode="" Description="Primary strategy candle interval." Type="Variable" Display="always" Required="true" Mask="false">15m</Config>
  <Config Name="Trend Interval" Target="TREND_INTERVAL" Default="1h" Mode="" Description="Higher-timeframe trend filter interval." Type="Variable" Display="always" Required="true" Mask="false">1h</Config>

  <Config Name="Paper Only Safety Lock" Target="PAPER_ONLY" Default="true" Mode="" Description="Must remain true. This release cannot place real-money orders." Type="Variable" Display="advanced" Required="true" Mask="false">true</Config>
  <Config Name="Hard Drawdown Limit" Target="HARD_DRAWDOWN" Default="0.10" Mode="" Description="Hard account drawdown limit. 0.10 = 10%." Type="Variable" Display="advanced" Required="true" Mask="false">0.10</Config>
  <Config Name="Fee Rate" Target="FEE_RATE" Default="0.001" Mode="" Description="Simulated trading fee rate. 0.001 = 0.1%." Type="Variable" Display="advanced" Required="true" Mask="false">0.001</Config>
  <Config Name="Slippage Rate" Target="SLIPPAGE_RATE" Default="0.0005" Mode="" Description="Simulated slippage rate. 0.0005 = 0.05%." Type="Variable" Display="advanced" Required="true" Mask="false">0.0005</Config>
  <Config Name="Fast EMA Window" Target="FAST_WINDOW" Default="9" Mode="" Description="Fast strategy window." Type="Variable" Display="advanced" Required="true" Mask="false">9</Config>
  <Config Name="Slow EMA Window" Target="SLOW_WINDOW" Default="21" Mode="" Description="Slow strategy window." Type="Variable" Display="advanced" Required="true" Mask="false">21</Config>
  <Config Name="Trend Fast Window" Target="TREND_FAST_WINDOW" Default="20" Mode="" Description="Fast higher-timeframe trend window." Type="Variable" Display="advanced" Required="true" Mask="false">20</Config>
  <Config Name="Trend Slow Window" Target="TREND_SLOW_WINDOW" Default="50" Mode="" Description="Slow higher-timeframe trend window." Type="Variable" Display="advanced" Required="true" Mask="false">50</Config>
  <Config Name="ATR Window" Target="ATR_WINDOW" Default="14" Mode="" Description="ATR calculation period." Type="Variable" Display="advanced" Required="true" Mask="false">14</Config>
  <Config Name="RSI Window" Target="RSI_WINDOW" Default="14" Mode="" Description="RSI calculation period." Type="Variable" Display="advanced" Required="true" Mask="false">14</Config>
  <Config Name="Stop ATR Multiple" Target="STOP_ATR_MULTIPLE" Default="1.5" Mode="" Description="ATR multiplier used for protective stops." Type="Variable" Display="advanced" Required="true" Mask="false">1.5</Config>
  <Config Name="Minimum Stop Percent" Target="MINIMUM_STOP_PCT" Default="0.006" Mode="" Description="Minimum stop distance. 0.006 = 0.6%." Type="Variable" Display="advanced" Required="true" Mask="false">0.006</Config>
  <Config Name="Take Profit R" Target="TAKE_PROFIT_R" Default="2.0" Mode="" Description="Take-profit target in R multiples." Type="Variable" Display="advanced" Required="true" Mask="false">2.0</Config>
  <Config Name="Trailing Trigger R" Target="TRAILING_TRIGGER_R" Default="1.0" Mode="" Description="R multiple that activates the trailing logic." Type="Variable" Display="advanced" Required="true" Mask="false">1.0</Config>
  <Config Name="History Bars" Target="HISTORY_BARS" Default="500" Mode="" Description="Bars loaded for live strategy calculations." Type="Variable" Display="advanced" Required="true" Mask="false">500</Config>
  <Config Name="Backtest Bars" Target="BACKTEST_BARS" Default="1000" Mode="" Description="Bars used by the backtest." Type="Variable" Display="advanced" Required="true" Mask="false">1000</Config>
  <Config Name="Poll Interval Seconds" Target="POLL_SECONDS" Default="60" Mode="" Description="Automatic scanner interval in seconds (30-900)." Type="Variable" Display="advanced" Required="true" Mask="false">60</Config>
  <Config Name="Session Close Hour" Target="SESSION_CLOSE_HOUR" Default="23" Mode="" Description="Daily session close hour in APP_TIMEZONE." Type="Variable" Display="advanced" Required="true" Mask="false">23</Config>
  <Config Name="Session Close Minute" Target="SESSION_CLOSE_MINUTE" Default="45" Mode="" Description="Daily session close minute." Type="Variable" Display="advanced" Required="true" Mask="false">45</Config>
  <Config Name="Cooldown Minutes" Target="COOLDOWN_MINUTES" Default="45" Mode="" Description="Cooldown after a completed trade before another entry." Type="Variable" Display="advanced" Required="true" Mask="false">45</Config>
  <Config Name="Application Timezone" Target="APP_TIMEZONE" Default="Europe/Berlin" Mode="" Description="Timezone used by the trading session logic." Type="Variable" Display="advanced" Required="true" Mask="false">Europe/Berlin</Config>
  <Config Name="Container Timezone" Target="TZ" Default="Europe/Berlin" Mode="" Description="Timezone used by the container and logs." Type="Variable" Display="advanced" Required="true" Mask="false">Europe/Berlin</Config>
  <Config Name="Data Directory" Target="DATA_DIR" Default="/data" Mode="" Description="Container path for persistent SQLite data. Keep /data with the path mapping above." Type="Variable" Display="advanced" Required="true" Mask="false">/data</Config>
  <Config Name="Fusion Base URL" Target="FUSION_BASE_URL" Default="https://api.fusion.bitpanda.com" Mode="" Description="Bitpanda Fusion API base URL." Type="Variable" Display="advanced" Required="true" Mask="false">https://api.fusion.bitpanda.com</Config>
</Container>
