# Optional Docker Compose override template.
# The project starts in demo mode without a .env file. Copy this file to .env
# only when you want persistent local overrides. Never commit a populated .env.

PAPER_ONLY=true

# Portfolio and hard risk limits
STARTING_CAPITAL=1000
RISK_PER_TRADE=0.005
MAX_AGGREGATE_RISK=0.01
MAX_DAILY_LOSS=0.02
HARD_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=2
MAX_TRADES_PER_DAY=3
FEE_RATE=0.001
SLIPPAGE_RATE=0.0005

# Strategy parameters
FAST_WINDOW=9
SLOW_WINDOW=21
TREND_FAST_WINDOW=20
TREND_SLOW_WINDOW=50
ATR_WINDOW=14
RSI_WINDOW=14
STOP_ATR_MULTIPLE=1.5
MINIMUM_STOP_PCT=0.006
TAKE_PROFIT_R=2.0
TRAILING_TRIGGER_R=1.0
PAIRS=BTC-EUR,ETH-EUR,SOL-EUR,XRP-EUR,ADA-EUR
CANDLE_INTERVAL=15m
TREND_INTERVAL=1h
HISTORY_BARS=500
BACKTEST_BARS=1000

# Market data: demo or fusion. A Fusion key must have Read permission only.
DATA_SOURCE=demo
FUSION_READ_API_KEY=
FUSION_BASE_URL=https://api.fusion.bitpanda.com

# Scheduling and persistence
APP_LANGUAGE=en
APP_TIMEZONE=Europe/Berlin
POLL_SECONDS=60
SESSION_CLOSE_HOUR=23
SESSION_CLOSE_MINUTE=45
COOLDOWN_MINUTES=45
DATA_DIR=/data
TZ=Europe/Berlin

# Docker Compose / host settings (not application variables in the Unraid template)
WEB_PORT=8787
PUID=99
PGID=100
