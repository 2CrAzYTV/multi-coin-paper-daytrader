# Optional Docker Compose override template.
# The project starts in demo mode without a .env file. Copy this file to .env
# only when you want persistent local overrides. Never commit a populated .env.

PAPER_ONLY=true

# Paper account and realistic costs (Bitpanda Fusion entry tier: 0.25% per order)
STARTING_CAPITAL=1000
FEE_RATE=0.0025
SLIPPAGE_RATE=0.0005
USE_ORDER_BOOK=true

# Strategy: Donchian trend following on daily candles, long only, spot
PAIRS=BTC-EUR,ETH-EUR,SOL-EUR,XRP-EUR
MAX_OPEN_POSITIONS=4
CANDLE_INTERVAL=1d
ENTRY_WINDOW=55
EXIT_WINDOW=20
ATR_WINDOW=20
HISTORY_BARS=120
BACKTEST_BARS=1440

# Market data: demo or fusion. A Fusion key must have Read permission only.
DATA_SOURCE=demo
FUSION_READ_API_KEY=
FUSION_BASE_URL=https://api.fusion.bitpanda.com

# Scheduling and persistence
APP_LANGUAGE=en
APP_TIMEZONE=Europe/Berlin
POLL_SECONDS=300
DATA_DIR=/data
TZ=Europe/Berlin

# Docker Compose / host settings (not application variables in the Unraid template)
WEB_PORT=8787
PUID=99
PGID=100
